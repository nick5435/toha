{
  "tex": {
    "inlineMath": [
      [
        "$",
        "$"
      ],
      [
        "\\(",
        "\\)"
      ]
    ],
    "displayMath": [
      [
        "$$",
        "$$"
      ],
      [
        "\\[",
        "\\]"
      ]
    ],
    "processEscapes": true,
    "processEnvironments": true
  },
  "options": {
    "enableSpeech": true,
    "enableBraille": false,
    "enableEnrichment": true,
    "enableComplexity": true,
    "enableExplorer": false,
    "menuOptions": {
      "settings": {
        "renderer": "CHTML"
      }
    },
    "skipHtmlTags": [
      "script",
      "noscript",
      "style",
      "textarea",
      "pre",
      "code",
      "annotation",
      "annotation-xml"
    ]
  },
  "chtml": {
    "fontURL": "/fonts/mathjax",
    "dynamicPrefix": "/fonts/mathjax/dynamic"
  },
  "loader": {
    "paths": {
      "mathjax": "/",
      "mathjax-newcm": "/fonts/mathjax"
    }
  },
  "startup": {
    "typeset": true
  }
}